# Copy to .env and fill in real values. Never commit the real .env — it's
# gitignored, but double-check before staging anything by hand.

# Hugging Face Hub token. Required to download Llama-3.3-70B (gated: needs
# license acceptance on huggingface.co + an authenticated token) — the other
# four models (Qwen2.5-7B/32B, Olmo3-7B/32B) are ungated but the same token
# works for all of them. Read-only scope is enough.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Where model weights and dataset caches are stored. Point this at large disk
# space OUTSIDE the git repo and outside any Docker image layer — Llama-3.3-70B
# fp16 alone is ~141GB (paper_draft.md's compute-constraint table).
HF_HOME=
HF_HUB_CACHE=
